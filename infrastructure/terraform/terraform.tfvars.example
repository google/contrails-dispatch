# --- REQUIRED VARIABLES ---

# The GCP Project ID where resources will be deployed
# project_id = "YOUR_GCP_PROJECT_ID"

# The email address that will receive alerts if the pipeline fails
# alert_email = "YOUR_EMAIL@YOUR_DOMAIN.COM"

# --- OPTIONAL OVERRIDES ---

# The GCP region for all resources (Defaults to us-west1)
# region = "us-central1"

# The name of the Pub/Sub topic (Defaults to flight-plan-xml-topic)
# pubsub_topic_name = "flight-plan-xml-topic"

# BigQuery Dataset and Table IDs (Defaults shown in variables.tf)
# bq_dataset_id = "flight_plan"
# bq_table_id   = "contrails_impact_history"
